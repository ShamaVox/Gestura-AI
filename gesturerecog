import numpy as np
from keras.models import load_model


# Load pre-trained gesture recognition model
model = load_model('gesture_recognition_model.h5')


def preprocess_frame(frame):
    # Resize frame to the input size expected by the model
    resized_frame = cv2.resize(frame, (64, 64))
    # Normalize pixel values
    normalized_frame = resized_frame / 255.0
    return np.expand_dims(normalized_frame, axis=0)


def recognize_gesture(frame):
    processed_frame = preprocess_frame(frame)
    prediction = model.predict(processed_frame)
    # Assuming the model outputs a one-hot encoded vector for gesture classes
    gesture_class = np.argmax(prediction)
    return gesture_class


def main():
    cap = cv2.VideoCapture(0)
    
    while(True):
        ret, frame = cap.read()
        if not ret:
            break
        
        gesture = recognize_gesture(frame)
        # Display the recognized gesture
        cv2.putText(frame, f'Gesture: {gesture}', (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 0, 0), 2, cv2.LINE_AA)
        cv2.imshow('Video Feed', frame)
        
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()


main()
