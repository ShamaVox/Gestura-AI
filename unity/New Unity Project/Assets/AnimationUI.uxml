<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1;">
        <ui:DropdownField label="Animation" name="animation-dropdown" style="flex-direction: row; align-items: center; justify-content: space-around; height: 31px; width: 457px; color: rgb(0, 250, 255); align-self: stretch; flex-grow: 1; flex-shrink: 1; overflow: hidden;" />
        <ui:Button text="Play" parse-escape-sequences="true" display-tooltip-when-elided="true" name="play-button" style="-unity-text-align: middle-center; height: 28px; width: 549px; flex-direction: column; align-items: auto; flex-grow: 1;" />
        <ui:VisualElement style="flex-grow: 99;" />
    </ui:VisualElement>
</ui:UXML>
