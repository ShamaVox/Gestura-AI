import tkinter as tk
from tkinter import Label
from threading import Thread


def update_label(label, text):
    label.config(text=text)
    label.after(1000, lambda: update_label(label, text))


def ui_thread():
    root = tk.Tk()
    root.title("Virtual Sign Language Interpreter")
    label = Label(root, text="Starting...", font=("Helvetica", 24))
    label.pack()
    root.after(1000, lambda: update_label(label, "Listening..."))
    root.mainloop()


# Run the UI in a separate thread
Thread(target=ui_thread).start()


# The main function can capture video and recognize gestures as shown earlier
main()
